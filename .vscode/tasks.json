{
    // See https://go.microsoft.com/fwlink/?LinkId=733558 
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/Fe:",
                "${fileDirname}//${fileBasenameNoExtension}.exe",
                "${file}",
                "/I",
                "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.25.28610/include",
                "/I",
                "C:/Program Files (x86)/Windows Kits/10/Include/10.0.18362.0/ucrt",
                "/link",
                "/LIBPATH:C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.25.28610/lib/onecore/x64",
                "/LIBPATH:C:/Program Files (x86)/Windows Kits/10/Lib/10.0.18362.0/um/x64",
                "/LIBPATH:C:/Program Files (x86)/Windows Kits/10/Lib/10.0.18362.0/ucrt/x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}